# Шаблон переменных окружения. Скопируйте в .env и заполните значения.
# .env в репозиторий не коммитится.

# --- Telegram ---
BOT_TOKEN=
# ID администраторов через запятую: 111111,222222
ADMIN_IDS=
CHANNEL_URL=https://t.me/your_channel
# Внутренний id основного канала, обычно начинается с -100.
# Пусто = проверка подписки отключена.
MAIN_CHANNEL_ID=

# --- Чаты для уведомлений (0 = не слать) ---
GROUP_CHAT_MESSAGES_ID=0
GROUP_CHAT_MESSAGES_BOT_ID=0
GROUP__B_CHAT_MESSAGES_BOT_ID=0

# --- База данных ---
# Драйвер в строке не важен: приложение приводит URL к asyncpg.
DATABASE_URL=postgresql://user:password@postgres:5432/whale_db
POSTGRES_DB=whale_db
POSTGRES_USER=user
POSTGRES_PASSWORD=

# --- Bitrix24 ---
# ВНИМАНИЕ: BITRIX_WEBHOOK_URL — это учётные данные. Кто знает ссылку,
# тот имеет полный доступ к CRM. Не коммитить, не пересылать в чатах.
BITRIX_WEBHOOK_URL=https://domain.bitrix24.ru/rest/1/xxxxx/
BITRIX_PORTAL_URL=https://domain.bitrix24.ru/

# UF-поля лида
BITRIX_FIELD_TG_ID_LEAD=
BITRIX_FIELD_TG_USERNAME_LEAD=
BITRIX_FIELD_TG_LINK_LEAD=
BITRIX_FIELD_TAG_LEAD=

# UF-поля сделки
BITRIX_FIELD_TG_ID_DEAL=
BITRIX_FIELD_TG_USERNAME_DEAL=
BITRIX_FIELD_TG_LINK_DEAL=
BITRIX_FIELD_TAG_DEAL=
BITRIX_FIELD_PHONE_DEAL=UF_CRM_1770809839968

# --- Лимиты и тайминги (можно не задавать) ---
BITRIX_MAX_RPS=2.0
BITRIX_TIMEOUT_SECONDS=20
BITRIX_VERIFY_SSL=true
BROADCAST_DELAY_SECONDS=0.05
# Антифлуд. 0 = выключить совсем (тогда защита от перегрузки Bitrix — только лимитер).
CLIENT_THROTTLE_SECONDS=0.5
CLIENT_CALLBACK_THROTTLE_SECONDS=0.3

# Логировать текст входящих сообщений (только для отладки)
DEBUG_LOG_INCOMING=false
SUBSCRIPTION_GATE_PHOTO_PATH=app/bot/assets/subscription_gate.png
# --- Картинки (file_id из Telegram) ---
WELCOME_PHOTO_FILE_ID=

BONUS_IMAGE_FILE_ID=
MANAGER_CONTACT_IMAGE_FILE_ID=
PREM_IMAGE_FILE_ID=
ROBOTS_IMAGE_FILE_ID=
AI_IMAGE_FILE_ID=
BREAKOUTGOLD_IMAGE_FILE_ID=
